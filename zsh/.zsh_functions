# create a dir and cd into it
newdir() {
	# show usage if there are no arguments
	if (( $# < 1 ))
	then
		echo usage: newdir folder
	else
		mkdir -p $1
		cd $1
	fi
}

# copy pwd to the clipboard
copy_pwd_to_clipboard() {
	PWD=(`pwd`)
	echo -n $PWD | pbcopy
}
# aliases for faster usage
alias cpwd="copy_pwd_to_clipboard"
