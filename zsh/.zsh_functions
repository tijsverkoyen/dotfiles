# create a dir and cd into it
newdir() {
	# show usage if there are no arguments
	if (( $# < 1 ))
	then
		echo usage: newdir folder
	else
		mkdir -p $1
		cd $1
	fi
}

# copy pwd to the clipboard
copy_pwd_to_clipboard() {
	PWD=(`pwd`)
	echo -n $PWD | pbcopy
}
# aliases for faster usage
alias cpwd="copy_pwd_to_clipboard"

# fix the proxy settings to use Symfony proxy
fix-proxy() {
  local pac_url="http://127.0.0.1:7080/proxy.pac"

  sudo networksetup -setautoproxyurl "Wi-Fi" "$pac_url"
  sudo networksetup -setautoproxystate "Wi-Fi" on

  sudo networksetup -setautoproxyurl "VPN SumoCoders" "$pac_url"
  sudo networksetup -setautoproxystate "VPN SumoCoders" on

  echo "Proxy PAC set to $pac_url on Wi-Fi and VPN SumoCoders"
}
