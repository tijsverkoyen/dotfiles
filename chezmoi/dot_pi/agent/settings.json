      "researcher": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ],
        "timeoutMs": 900000
      },
      "reviewer": {
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
