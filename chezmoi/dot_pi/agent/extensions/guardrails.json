{
  "$schema": "https://unpkg.com/@aliou/pi-guardrails@0.17.1/schema.json",
  "applyBuiltinDefaults": true,
  "version": "0.17.1",
  "onboarding": {
    "completed": true,
    "completedAt": "2026-08-28T13:58:28.424Z",
    "version": "0.17.1"
  },
  "features": {
    "pathAccess": true
  },
  "pathAccess": {
    "mode": "ask",
    "allowedPaths": [
      {
        "kind": "file",
        "path": "/dev/null"
      },
      {
        "kind": "directory",
        "path": "/tmp"
      }
    ]
  },
  "policies": {
    "rules": [
      {
        "id": "secret-files",
        "description": "Files containing secrets (migrated from envFiles)",
        "protection": "noAccess",
        "patterns": [
          {
            "pattern": ".env"
          },
          {
            "pattern": ".env.*"
          }
        ],
        "allowedPatterns": [
          {
            "pattern": "~/Sites/sumocoders/claude-plugin/.env.local"
          },
          {
            "pattern": ".env"
          }
        ]
      }
    ]
  }
}
