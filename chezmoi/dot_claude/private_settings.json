{
  "permissions": {
    "allow": [
      "Bash(rtk wc *)",
      "Bash(rtk ls *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)"
    ]
  },
  "skillOverrides": {
    "graphify": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/tijs/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "symfony-ux@symfony-ux": false,
    "sumo@sumocoders": true,
    "context-mode@context-mode": true,
    "claude-code-setup@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true,
    "code-modernization@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "symfony-ux": {
      "source": {
        "source": "directory",
        "path": "/Users/tijs/Sites/tijsverkoyen/symfony-ux-skills"
      }
    },
    "sumocoders": {
      "source": {
        "source": "directory",
        "path": "/Users/tijs/Sites/sumocoders/claude-plugin"
      },
      "autoUpdate": true
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "skipAutoPermissionPrompt": true
}
